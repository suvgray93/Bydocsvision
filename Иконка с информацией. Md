## 📄 Полная HTML-страница

```html
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Info Tooltip</title>

<style>
    body {
        font-family: Arial, sans-serif;
        padding: 60px;
        line-height: 1.5;
    }

    .info-wrapper {
        position: relative;
        display: inline-block;
        margin: 40px;
    }

    .info-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #007bff;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        cursor: pointer;
        user-select: none;
        transition: background 0.2s ease;
    }

    .info-icon:hover {
        background: #0056b3;
    }

    .info-message {
        position: fixed;
        min-width: 220px;
        max-width: 280px;
        padding: 14px;
        background: #333;
        color: #fff;
        border-radius: 8px;
        font-size: 14px;
        z-index: 1000;

        opacity: 0;
        transform: translateY(-8px);
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .info-message.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* стрелка */
    .info-message::after {
        content: "";
        position: absolute;
        left: 20px;
        border: 6px solid transparent;
    }

    .info-message.bottom::after {
        top: -12px;
        border-bottom-color: #333;
    }

    .info-message.top::after {
        bottom: -12px;
        border-top-color: #333;
    }

    @media (max-width: 600px) {
        .info-message {
            max-width: 90vw;
        }
    }
</style>
</head>

<body>

<h2>Несколько информационных иконок</h2>

<div class="info-wrapper">
    <div class="info-icon" data-info="Сообщение первой иконки">i</div>
</div>

<div class="info-wrapper">
    <div class="info-icon" data-info="Второе сообщение. Оно может быть длиннее и автоматически позиционируется.">i</div>
</div>

<div class="info-wrapper">
    <div class="info-icon" data-info="Третья иконка тоже полностью независима.">i</div>
</div>

<script>
    let activeTooltip = null;

    function createTooltip(text) {
        const tooltip = document.createElement('div');
        tooltip.className = 'info-message';
        tooltip.textContent = text;
        document.body.appendChild(tooltip);
        return tooltip;
    }

    function positionTooltip(icon, tooltip) {
        const rect = icon.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const spaceBelow = window.innerHeight - rect.bottom;
        const spaceAbove = rect.top;

        let top, left;
        left = rect.left + rect.width / 2 - tooltipRect.width / 2;

        // Ограничение по горизонтали
        left = Math.max(10, Math.min(left, window.innerWidth - tooltipRect.width - 10));

        if (spaceBelow > tooltipRect.height + 10) {
            // Снизу
            top = rect.bottom + 10;
            tooltip.classList.remove('top');
            tooltip.classList.add('bottom');
        } else {
            // Сверху
            top = rect.top - tooltipRect.height - 10;
            tooltip.classList.remove('bottom');
            tooltip.classList.add('top');
        }

        tooltip.style.top = top + 'px';
        tooltip.style.left = left + 'px';
    }

    function closeTooltip() {
        if (activeTooltip) {
            activeTooltip.remove();
            activeTooltip = null;
        }
    }

    document.querySelectorAll('.info-icon').forEach(icon => {

        icon.addEventListener('click', (e) => {
            e.stopPropagation();

            if (activeTooltip) {
                closeTooltip();
            }

            const tooltip = createTooltip(icon.dataset.info);
            positionTooltip(icon, tooltip);

            requestAnimationFrame(() => {
                tooltip.classList.add('active');
            });

            activeTooltip = tooltip;
        });

        icon.parentElement.addEventListener('mouseleave', () => {
            closeTooltip();
        });
    });

    document.addEventListener('click', () => {
        closeTooltip();
    });

    window.addEventListener('resize', () => {
        closeTooltip();
    });
</script>

</body>
</html>
```

