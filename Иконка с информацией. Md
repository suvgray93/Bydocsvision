```html
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Информационная иконка</title>

<style>
    body {
        font-family: Arial, sans-serif;
        padding: 50px;
    }

    .info-wrapper {
        position: relative;
        display: inline-block;
    }

    .info-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #007bff;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-weight: bold;
        user-select: none;
        transition: background-color 0.2s ease;
    }

    .info-icon:hover {
        background-color: #0056b3;
    }

    .info-message {
        position: absolute;
        top: 48px;
        left: 0;
        min-width: 240px;
        padding: 14px;
        background-color: #333;
        color: #fff;
        border-radius: 8px;
        font-size: 14px;
        z-index: 10;

        /* Анимация */
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .info-message.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* 📱 Мобильная версия */
    @media (max-width: 600px) {
        body {
            padding: 20px;
        }

        .info-message {
            left: 50%;
            transform: translate(-50%, -10px);
            width: 90vw;
            max-width: 320px;
        }

        .info-message.active {
            transform: translate(-50%, 0);
        }
    }
</style>
</head>

<body>

<h2>Информационная иконка</h2>

<div class="info-wrapper" id="infoWrapper">
    <div class="info-icon" id="infoIcon">i</div>
    <div class="info-message" id="infoMessage">
        Это информационное сообщение.  
        Оно плавно появляется при нажатии на иконку.
        На мобильных устройствах закрывается повторным нажатием
        или кликом вне блока.
    </div>
</div>

<script>
    const wrapper = document.getElementById('infoWrapper');
    const icon = document.getElementById('infoIcon');
    const message = document.getElementById('infoMessage');

    // Открытие / закрытие по клику
    icon.addEventListener('click', (e) => {
        e.stopPropagation();
        message.classList.toggle('active');
    });

    // Закрытие при уходе курсора (десктоп)
    wrapper.addEventListener('mouseleave', () => {
        message.classList.remove('active');
    });

    // Закрытие при клике вне блока (мобильные + десктоп)
    document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) {
            message.classList.remove('active');
        }
    });
</script>

</body>
</html>
```

