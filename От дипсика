Вот компонент React для таблицы с согласованием компаний, который загружает данные при монтировании:

```jsx
import React, { useState, useEffect } from 'react';
import './ApprovalTable.css'; // Стили для таблицы

const ApprovalTable = () => {
  const [companies, setCompanies] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Загрузка данных при монтировании компонента
  useEffect(() => {
    fetchCompanies();
  }, []);

  // Функция для загрузки данных о компаниях
  const fetchCompanies = async () => {
    try {
      setLoading(true);
      // Здесь замените URL на ваш реальный endpoint
      const response = await fetch('https://api.example.com/companies/pending-approval');
      
      if (!response.ok) {
        throw new Error(`Ошибка HTTP: ${response.status}`);
      }
      
      const data = await response.json();
      setCompanies(data);
      setError(null);
    } catch (err) {
      setError(`Ошибка загрузки данных: ${err.message}`);
      console.error('Ошибка при загрузке компаний:', err);
    } finally {
      setLoading(false);
    }
  };

  // Функция для согласования компании
  const handleApprove = async (companyId) => {
    try {
      // Отправляем запрос на согласование
      const response = await fetch(`https://api.example.com/companies/${companyId}/approve`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        // Если нужно передать дополнительные данные
        body: JSON.stringify({
          approvedBy: 'currentUserId', // Замените на реальный ID пользователя
          approvalDate: new Date().toISOString(),
        }),
      });

      if (!response.ok) {
        throw new Error(`Ошибка при согласовании: ${response.status}`);
      }

      // Обновляем локальное состояние
      setCompanies(prevCompanies =>
        prevCompanies.map(company =>
          company.id === companyId
            ? { ...company, approvalResult: 'approved', approvalDate: new Date().toISOString() }
            : company
        )
      );
    } catch (err) {
      console.error('Ошибка при согласовании компании:', err);
      alert('Не удалось согласовать компанию. Попробуйте еще раз.');
    }
  };

  // Функция для отказа в согласовании
  const handleReject = async (companyId) => {
    try {
      // Отправляем запрос на отказ
      const response = await fetch(`https://api.example.com/companies/${companyId}/reject`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          rejectedBy: 'currentUserId', // Замените на реальный ID пользователя
          rejectionReason: 'Не соответствует требованиям', // Можно добавить поле для ввода причины
          rejectionDate: new Date().toISOString(),
        }),
      });

      if (!response.ok) {
        throw new Error(`Ошибка при отказе: ${response.status}`);
      }

      // Обновляем локальное состояние
      setCompanies(prevCompanies =>
        prevCompanies.map(company =>
          company.id === companyId
            ? { ...company, approvalResult: 'rejected', rejectionDate: new Date().toISOString() }
            : company
        )
      );
    } catch (err) {
      console.error('Ошибка при отказе в согласовании компании:', err);
      alert('Не удалось отклонить компанию. Попробуйте еще раз.');
    }
  };

  // Функция для форматирования даты
  const formatDate = (dateString) => {
    if (!dateString) return '—';
    const date = new Date(dateString);
    return date.toLocaleDateString('ru-RU', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  };

  // Функция для отображения статуса согласования
  const renderApprovalStatus = (approvalResult, approvalDate, rejectionDate) => {
    switch (approvalResult) {
      case 'approved':
        return (
          <span className="status approved">
            ✅ Согласовано {formatDate(approvalDate)}
          </span>
        );
      case 'rejected':
        return (
          <span className="status rejected">
            ❌ Отклонено {formatDate(rejectionDate)}
          </span>
        );
      default:
        return (
          <span className="status pending">
            ⏳ Ожидает согласования
          </span>
        );
    }
  };

  // Функция для отображения кнопок действий
  const renderActionButtons = (company) => {
    // Если уже есть результат согласования, не показываем кнопки
    if (company.approvalResult) {
      return null;
    }

    return (
      <div className="action-buttons">
        <button
          className="btn-approve"
          onClick={() => handleApprove(company.id)}
          title="Согласовать компанию"
        >
          ✅ Согласовать
        </button>
        <button
          className="btn-reject"
          onClick={() => handleReject(company.id)}
          title="Отклонить компанию"
        >
          ❌ Отклонить
        </button>
      </div>
    );
  };

  if (loading) {
    return (
      <div className="loading-container">
        <div className="spinner"></div>
        <p>Загрузка данных о компаниях...</p>
      </div>
    );
  }

  if (error) {
    return (
      <div className="error-container">
        <p className="error-message">{error}</p>
        <button onClick={fetchCompanies} className="btn-retry">
          Попробовать снова
        </button>
      </div>
    );
  }

  if (companies.length === 0) {
    return (
      <div className="empty-state">
        <p>Нет компаний, ожидающих согласования</p>
      </div>
    );
  }

  return (
    <div className="approval-table-container">
      <div className="table-header">
        <h2>Согласование регистрации компаний</h2>
        <div className="header-info">
          <span className="total-count">Всего компаний: {companies.length}</span>
          <span className="pending-count">
            Ожидают решения: {companies.filter(c => !c.approvalResult).length}
          </span>
        </div>
      </div>

      <div className="table-responsive">
        <table className="approval-table">
          <thead>
            <tr>
              <th>№</th>
              <th>Название компании</th>
              <th>ИНН</th>
              <th>ОГРН</th>
              <th>Юридический адрес</th>
              <th>Контактное лицо</th>
              <th>Телефон</th>
              <th>Email</th>
              <th>Дата регистрации</th>
              <th>Статус согласования</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            {companies.map((company, index) => (
              <tr 
                key={company.id} 
                className={`company-row ${company.approvalResult ? 'processed' : 'pending-row'}`}
              >
                <td className="index-cell">{index + 1}</td>
                <td className="company-name">{company.name}</td>
                <td>{company.inn}</td>
                <td>{company.ogrn}</td>
                <td className="address-cell">{company.legalAddress}</td>
                <td>{company.contactPerson}</td>
                <td>{company.phone}</td>
                <td>{company.email}</td>
                <td>{formatDate(company.registrationDate)}</td>
                <td className="status-cell">
                  {renderApprovalStatus(
                    company.approvalResult, 
                    company.approvalDate, 
                    company.rejectionDate
                  )}
                </td>
                <td className="actions-cell">
                  {renderActionButtons(company)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="table-footer">
        <div className="legend">
          <div className="legend-item">
            <span className="legend-color pending"></span>
            <span>Ожидает решения</span>
          </div>
          <div className="legend-item">
            <span className="legend-color approved"></span>
            <span>Согласовано</span>
          </div>
          <div className="legend-item">
            <span className="legend-color rejected"></span>
            <span>Отклонено</span>
          </div>
        </div>
        <button 
          onClick={fetchCompanies} 
          className="btn-refresh"
          title="Обновить данные"
        >
          🔄 Обновить
        </button>
      </div>
    </div>
  );
};

export default ApprovalTable;
```

