// Пример использования в DI контейнере (Program.cs или Startup.cs)
public static class ServiceExtensions
{
    public static IServiceCollection AddDapperRepository(this IServiceCollection services, string connectionString)
    {
        services.AddScoped<IRepository>(provider =>
        {
            var logger = provider.GetRequiredService<ILogger<DapperRepository>>();
            return new DapperRepository(connectionString, logger);
        });
        
        return services;
    }
}

// Пример использования в контроллере
[ApiController]
[Route("api/[controller]")]
public class UsersController : ControllerBase
{
    private readonly IRepository _repository;

    public UsersController(IRepository repository)
    {
        _repository = repository;
    }

    [HttpGet("search")]
    public async Task<IActionResult> SearchUsers(string term)
    {
        var users = await _repository.SearchAsync<User>(term, "Name");
        return Ok(users);
    }

    [HttpGet("search-email")]
    public async Task<IActionResult> SearchByEmail(string term)
    {
        var users = await _repository.SearchAsync<User>(term, "Email");
        return Ok(users);
    }

    [HttpGet("search-multiple")]
    public async Task<IActionResult> SearchByMultipleFields(string term)
    {
        var users = await _repository.SearchByMultipleFieldsAsync<User>(
            term, "Name", "Email", "Description");
        return Ok(users);
    }

    [HttpGet("paged")]
    public async Task<IActionResult> GetPagedUsers(string term, int page = 1, int pageSize = 10)
    {
        var result = await _repository.SearchWithPaginationAsync<User>(term, "Name", page, pageSize);
        return Ok(new
        {
            result.Items,
            result.TotalCount,
            Page = page,
            PageSize = pageSize,
            TotalPages = (int)Math.Ceiling(result.TotalCount / (double)pageSize)
        });
    }
}
